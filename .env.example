# Cấu hình cổng chạy ứng dụng React
PORT=3002

# Google Gemini API Key cho Gia sư ảo Quizzy AI (NNT Academy)
# Lấy API Key miễn phí tại: https://aistudio.google.com/
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot API thông báo đăng ký tư vấn lộ trình
# Tạo Bot tại Telegram: @BotFather (lấy Token)
REACT_APP_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID cá nhân nhận tin nhắn (lấy ID tại Telegram: @userinfobot)
REACT_APP_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Lưu ý: Cấu hình Backend (PORT 3001, JWT_SECRET, DB_PATH) nằm tại file `server/.env` (tham khảo `server/.env.example`)
